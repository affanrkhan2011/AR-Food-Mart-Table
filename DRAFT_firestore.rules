rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    // Validate a single order item
    function isValidOrderItem(item) {
      return item.keys().hasAll(['orderItemId', 'name', 'quantity', 'price', 'served']) &&
             item.orderItemId is string && item.orderItemId.size() <= 128 &&
             item.name is string && item.name.size() <= 100 &&
             item.quantity is number && item.quantity > 0 &&
             item.price is number && item.price >= 0 &&
             item.served is bool;
    }

    // Orders Collection
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['table', 'items', 'subtotal', 'status', 'timestamp']) &&
               data.table is string && data.table.size() <= 10 &&
               data.items is list && data.items.size() <= 50 &&
               data.subtotal is number && data.subtotal >= 0 &&
               data.status in ['NEW', 'SEEN', 'DONE', 'ARCHIVED'] &&
               data.timestamp is string;
      }

      // Allow public creation
      allow create: if isValidOrder(incoming());
      
      // Allow public read (customer needs to see their table orders)
      allow read: if true;

      // Allow updates (Staff dashboard)
      allow update: if isValidOrder(incoming()) && (
        // Action: Acknowledge
        (incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'SEEN') ||
        // Action: Serve item
        (incoming().diff(existing()).affectedKeys().hasOnly(['items', 'status'])) ||
        // Action: Archive
        (incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'ARCHIVED')
      );
    }

    // Bill Requests Collection
    match /billRequests/{requestId} {
      function isValidBillRequest(data) {
        return data.keys().hasAll(['table', 'orders', 'total', 'status', 'timestamp']) &&
               data.table is string && data.table.size() <= 10 &&
               data.orders is list &&
               data.total is number && data.total >= 0 &&
               data.status in ['PENDING', 'COMPLETED'] &&
               data.timestamp is string;
      }

      allow create: if isValidBillRequest(incoming());
      allow read: if true;
      allow update: if isValidBillRequest(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status == 'COMPLETED';
    }

    // Menu State
    match /menuState/availability {
      allow read: if true;
      allow write: if true; // Public for now since no staff login, but ideally restricted
    }
  }
}
